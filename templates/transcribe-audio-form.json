{
	"name": "Fish Audio: transcribe an uploaded audio file",
	"nodes": [
		{
			"parameters": {
				"content": "## Transcribe an uploaded audio file\nA form where anyone with the link uploads a recording and gets the transcript back. The transcript drops the speaker labels (`<|speaker:0|>`) that the Transcribe 1 Pro model adds. The full result, with timestamps and speaker turns, is in the execution data for further steps (for example, save it to a sheet or send it by email).\n\n**Setup**\n1. Open **Upload form** and create a **Basic Auth** credential (a user name and a password). Share them only with the people who may use the form: each use spends your Fish Audio credits.\n2. Open **Transcribe** and select your Fish Audio credential (API key from https://fish.audio/app/api-keys).\n3. Publish (activate) the workflow and open the form's production URL.",
				"height": 360,
				"width": 420
			},
			"id": "6c2d1a8e-3f4b-4e9a-9b1c-2d3e4f5a6b01",
			"name": "Sticky Note",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-200, -220]
		},
		{
			"parameters": {
				"authentication": "basicAuth",
				"formTitle": "Transcribe audio",
				"formDescription": "Upload a recording (MP3, WAV, M4A, OGG or similar) to get its transcript.",
				"formFields": {
					"values": [
						{
							"fieldLabel": "Audio file",
							"fieldType": "file",
							"multipleFiles": false,
							"acceptFileTypes": ".mp3,.wav,.m4a,.ogg,.opus,.flac,.webm,.aac",
							"requiredField": true
						},
						{
							"fieldLabel": "Language",
							"fieldType": "dropdown",
							"fieldOptions": {
								"values": [
									{ "option": "Auto-detect" },
									{ "option": "English" },
									{ "option": "Chinese" },
									{ "option": "Japanese" },
									{ "option": "Korean" },
									{ "option": "Spanish" },
									{ "option": "French" },
									{ "option": "German" },
									{ "option": "Portuguese" }
								]
							}
						}
					]
				},
				"options": {}
			},
			"id": "6c2d1a8e-3f4b-4e9a-9b1c-2d3e4f5a6b02",
			"name": "Upload form",
			"type": "n8n-nodes-base.formTrigger",
			"typeVersion": 2.2,
			"position": [0, 160],
			"webhookId": "2b7c3d4e-5f60-4a71-8b92-a3b4c5d6e7f8"
		},
		{
			"parameters": {
				"operation": "transcribe",
				"binaryPropertyName": "Audio_file",
				"options": {
					"language": "={{ { 'English': 'en', 'Chinese': 'zh', 'Japanese': 'ja', 'Korean': 'ko', 'Spanish': 'es', 'French': 'fr', 'German': 'de', 'Portuguese': 'pt' }[$json.Language] || '' }}"
				}
			},
			"id": "6c2d1a8e-3f4b-4e9a-9b1c-2d3e4f5a6b03",
			"name": "Transcribe",
			"type": "@fishaudio/n8n-nodes-fishaudio.fishaudio",
			"typeVersion": 1.2,
			"position": [240, 160]
		},
		{
			"parameters": {
				"operation": "completion",
				"completionTitle": "Transcript",
				"completionMessage": "={{ $json.text.replace(/<\\|speaker:[^|]*\\|>\\s*/g, '') }}",
				"options": {}
			},
			"id": "6c2d1a8e-3f4b-4e9a-9b1c-2d3e4f5a6b04",
			"name": "Show transcript",
			"type": "n8n-nodes-base.form",
			"typeVersion": 1,
			"position": [480, 160],
			"webhookId": "3c8d4e5f-6a71-4b82-9ca3-b4c5d6e7f809"
		}
	],
	"connections": {
		"Upload form": { "main": [[{ "node": "Transcribe", "type": "main", "index": 0 }]] },
		"Transcribe": { "main": [[{ "node": "Show transcript", "type": "main", "index": 0 }]] }
	},
	"settings": { "executionOrder": "v1" },
	"pinData": {}
}
